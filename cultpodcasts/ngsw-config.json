{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/manifest-dark.webmanifest",
          "/*.css",
          "/*.js",
          "/*.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "homepage",
      "urls": [
        "https://api-preview.cultpodcasts.com/homepage",
        "https://local.cultpodcasts.com:8787/homepage"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "5m",
        "timeout": "5s",
        "refreshAhead": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api",
      "urls": [
        "https://api-preview.cultpodcasts.com/**",
        "https://local.cultpodcasts.com:8787/**",
        "!https://api-preview.cultpodcasts.com/title-casing-rules",
        "!https://api-preview.cultpodcasts.com/title-casing-rules/**",
        "!https://local.cultpodcasts.com:8787/title-casing-rules",
        "!https://local.cultpodcasts.com:8787/title-casing-rules/**",
        "!https://api-preview.cultpodcasts.com/supported-languages",
        "!https://api-preview.cultpodcasts.com/supported-languages/**",
        "!https://local.cultpodcasts.com:8787/supported-languages",
        "!https://local.cultpodcasts.com:8787/supported-languages/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "5m",
        "timeout": "30s",
        "strategy": "freshness"
      }
    }
  ]
}
