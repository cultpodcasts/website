{
  "name": "cultpodcasts",
  "version": "1.12.0",
  "scripts": {
    "ng": "ng",
    "start": "node ./tools/start-local.mjs",
    "build": "ng build --configuration",
    "build:staging": "ng build --configuration staging",
    "build:local": "ng build --configuration local",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "test:e2e:catalogue": "playwright test -c playwright.catalogue.config.ts",
    "test:e2e:hero-layout": "playwright test e2e/hero-layout.spec.ts",
    "test:e2e:chrome-search": "playwright test e2e/chrome-search-layout.spec.ts",
    "test:e2e:submit-url": "playwright test e2e/submit-url-flows.spec.ts e2e/submit-url-flows.tour.spec.ts",
    "test:all": "npm run assert:svg-icons && npm run test && npm run test:e2e && npm run test:e2e:catalogue",
    "assert:svg-icons": "node ./tools/generate-svg-icon-literals.mjs --check",
    "prepare": "node ./tools/install-git-hooks.cjs",
    "serve:ssr:cultpodcasts": "node dist/server/server.mjs",
    "process": "node ./tools/copy-files.mjs && node ./tools/alter-polyfills.mjs",
    "deploy": "npm run build -- production && npm run process && wrangler pages deploy dist/cloudflare",
    "dev": "ng serve --configuration development",
    "generate:svg-icons": "node ./tools/generate-svg-icon-literals.mjs",
    "deps:check": "node ./tools/check-dependency-updates.mjs",
    "auth0:sync-staging-urls": "node ./tools/sync-auth0-staging-urls.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/service-worker": "22.2.1",
    "@angular/ssr": "22.2.1",
    "@auth0/auth0-angular": "^2.13.0",
    "country-flag-emoji-polyfill": "^0.1.10",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@types/express": "^4.17.17",
    "@types/node": "26.6.4",
    "baseline-browser-mapping": "2.11.27",
    "happy-dom": "20.14.5",
    "sass": "^1.105.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "4.146.0"
  }
}
