{
    "title": [
        {
            "name": "Podcast Name Suffix",
            "pattern": "^(?'title'.*?)(?'suffix' \\| {podcastName})?$"
        }
    ],
    "description": [
        {
            "name": "Remove description",
            "pattern": "^.*(?'body')$"
        },
        {
            "name": "remove opening hash tags",
            "pattern": "^\\s*(?:#[\\w-]+\\s*)+(?'body'.*)\\z"
        }
    ]
}
